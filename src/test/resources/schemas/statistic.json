{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ответ GET /api/{1,2}/statistic/{id}",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["likes", "viewCount", "contacts"],
    "additionalProperties": false,
    "properties": {
      "likes": { "type": "integer" },
      "viewCount": { "type": "integer" },
      "contacts": { "type": "integer" }
    }
  }
}
